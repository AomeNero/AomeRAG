# Copy to .env and fill in. All vars are optional (defaults shown).

# ---- LLM (DeepSeek, OpenAI-compatible). Use deepseek-chat (supports tools). ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MAX_CONCURRENT_LLM=8

# ---- Ollama (bge-m3 embeddings, dense only, 1024-d) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
EMBED_DIM=1024
MAX_CONCURRENT_EMBEDS=4

# ---- Zvec (in-process vector DB; writes are single-process exclusive) ----
ZVEC_PATH=./data/zvec
KB_COLLECTION=kb_chunks_v1

# ---- Retrieval (dense + Zvec FTS hybrid) ----
TOP_K=6
DENSE_WEIGHT=0.7
FTS_WEIGHT=0.3

# ---- Agent loop ----
MAX_CONCURRENT_LOOPS=16
MAX_ITERATIONS=50

# ---- Session history (SQLite) ----
SQLITE_PATH=./data/sessions.db

# ---- Auth (v1: comma-separated tokens; or trust X-User-Id from a gateway) ----
AUTH_TOKENS=

# ---- Skills drop-in directory ----
SKILLS_DIR=./skills

# ---- Raw data (originals) / cleaned markdown output ----
RAW_DATA_DIR=./raw/raw-data
MD_DATA_DIR=./raw/md-data

# ---- Built frontend (served by FastAPI when present; dev uses Vite separately) ----
FRONTEND_DIST=./web/dist

LOG_LEVEL=INFO

# ---- File logging (logs/app/ + logs/access/, one file per day, kept 30 days) ----
LOG_DIR=./logs
LOG_TO_FILE=true          # master switch: false → console only
LOG_APP_TO_FILE=true      # app + uvicorn lifecycle/error logs
LOG_ACCESS_TO_FILE=true   # uvicorn per-request access logs
LOG_RETENTION_DAYS=30

# ---- Agent workspace (sandbox for built-in read/write/edit/bash tools) ----
WORKSPACE_DIR=./workspace
WORKSPACE_RETENTION_DAYS=7  # 启动时清理 N 天前的生成文件（交付回收）
